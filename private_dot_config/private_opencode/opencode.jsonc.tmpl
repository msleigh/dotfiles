{
  "$schema": "https://opencode.ai/config.json",
{{- if or (eq .machine "work") (eq .machine "atos") }}
  "model": "github-copilot/claude-opus-5.5",
  "provider": {
    "ecmwf-bluster": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ECMWF Bluster",
      "options": {
        "baseURL": "https://bluster.ecmwf.int/api"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen 3.8 27B"
        },
        "pytorch/Qwen3-8B-INT4": {
          "name": "Qwen 3 8B INT4"
        }
      }
    }
  }
{{- else }}
  "model": "openai/gpt-5.6-sol"
{{- end }}
}
