#!/usr/bin/env bash
#
# jira-broker — credential-safe CLI for ECMWF Jira (Atlassian Data Center).
#
# The Personal Access Token is read from a local file at run time and handed to
# curl through a stdin config block, so it never appears in argv, `ps` output,
# shell history, logs, source control, or anything sent to an LLM.
# Only the data you explicitly request is printed.
#
# Local config (never committed):
#   ${XDG_CONFIG_HOME:-~/.config}/jira/pat[_*] -> file containing only the PAT (chmod 600)
#   ${XDG_CONFIG_HOME:-~/.config}/jira/config  -> optional line: base_url=<url>
# Overrides: JIRA_BASE_URL, JIRA_PAT_FILE.
# Base URL defaults to https://jira.ecmwf.int.

set -euo pipefail

readonly PROG="jira-broker"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/jira"
readonly DEFAULT_BASE_URL="https://jira.ecmwf.int"
readonly API="rest/api/2"

# jq helpers: split a comma-separated list; render a field value for display.
readonly JQ_CSV='def csv: split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0));'
readonly JQ_SHOW='def show:
  if type == "array" then (if length == 0 then "(none)" else map(show) | join(", ") end)
  elif type == "object" then (.name // .value // .displayName // .key // tostring)
  elif . == null then "(none)"
  else tostring end;'

ASSUME_YES=0
BASE_URL=""
PAT_FILE=""
TMP_DIR=""

die() {
  printf '%s: %s\n' "${PROG}" "${*}" >&2
  exit 1
}

warn() {
  printf '%s: %s\n' "${PROG}" "${*}" >&2
}

need() {
  command -v "${1}" >/dev/null 2>&1 || die "required command not found: ${1}"
}

cleanup() {
  if [[ -n "${TMP_DIR}" ]]; then
    rm -rf "${TMP_DIR}"
  fi
}

tmp_body() {
  [[ -n "${TMP_DIR}" ]] || TMP_DIR="$(mktemp -d)"
  mktemp "${TMP_DIR}/body.XXXXXX"
}

file_perms() {
  stat -c '%a' "${1}" 2>/dev/null || stat -f '%Lp' "${1}"
}

resolve_base_url() {
  if [[ -n "${JIRA_BASE_URL:-}" ]]; then
    printf '%s' "${JIRA_BASE_URL%/}"
    return
  fi
  local cfg="${CONFIG_DIR}/config" url
  if [[ -f "${cfg}" ]]; then
    url="$(sed -n 's/^base_url=//p' "${cfg}" | head -n1)"
    if [[ -n "${url}" ]]; then
      printf '%s' "${url%/}"
      return
    fi
  fi
  printf '%s' "${DEFAULT_BASE_URL}"
}

resolve_pat_file() {
  if [[ -n "${JIRA_PAT_FILE:-}" ]]; then
    [[ -f "${JIRA_PAT_FILE}" ]] || die "JIRA_PAT_FILE not found: ${JIRA_PAT_FILE}"
    printf '%s' "${JIRA_PAT_FILE}"
    return
  fi
  if [[ -f "${CONFIG_DIR}/pat" ]]; then
    printf '%s' "${CONFIG_DIR}/pat"
    return
  fi
  local f
  for f in "${CONFIG_DIR}"/pat_*; do
    if [[ -f "${f}" ]]; then
      printf '%s' "${f}"
      return
    fi
  done
  die "no PAT file in ${CONFIG_DIR} (expected 'pat' or 'pat_*'); set JIRA_PAT_FILE"
}

# Resolve and validate credentials once, in the top-level shell, so a missing
# PAT aborts cleanly (die inside a nested $(...) would not).
preflight() {
  local perms
  BASE_URL="$(resolve_base_url)"
  PAT_FILE="$(resolve_pat_file)"
  perms="$(file_perms "${PAT_FILE}")"
  case "${perms}" in
    600 | 400) ;;
    *) warn "insecure permissions ${perms} on ${PAT_FILE}; run: chmod 600 ${PAT_FILE}" ;;
  esac
}

# Forward all arguments to curl, injecting the bearer token via a stdin config
# block so it is never visible in the process arguments.
curl_auth() {
  local pat
  pat="$(tr -d '\r\n' <"${PAT_FILE}")"
  printf 'header = "Authorization: Bearer %s"\n' "${pat}" |
    curl -sS --fail-with-body -K - "${@}"
}

# api METHOD PATH [extra curl args...] -> prints response body, non-zero on HTTP error
api() {
  local method="${1}" path="${2}"
  shift 2
  local out status
  out="$(curl_auth -X "${method}" -H 'Accept: application/json' -H 'X-Atlassian-Token: no-check' "${@}" "${BASE_URL}/${path}")" && status=0 || status=${?}
  if [[ "${status}" -ne 0 ]]; then
    printf '%s: request failed (%s %s):\n%s\n' "${PROG}" "${method}" "${path}" "${out}" >&2
    return "${status}"
  fi
  printf '%s' "${out}"
}

require_yes() {
  if [[ "${ASSUME_YES}" -ne 1 ]]; then
    die "write refused without confirmation. Ask the user, then re-run with --yes: ${PROG} ${*}"
  fi
}

# Single-quote an argument for display if it contains anything but safe characters.
shell_quote() {
  if [[ "${1}" =~ ^[A-Za-z0-9_.,/:=+-]+$ ]]; then
    printf '%s' "${1}"
  else
    printf "'%s'" "${1//\'/\'\\\'\'}"
  fi
}

cmd_whoami() {
  api GET "${API}/myself" | jq -r '"\(.displayName) (\(.name)) <\(.emailAddress // "?")>"'
}

cmd_search() {
  local jql="${1:?usage: search <JQL> [max]}" max="${2:-50}"
  api GET "${API}/search" -G \
    --data-urlencode "jql=${jql}" \
    --data-urlencode "maxResults=${max}" \
    --data-urlencode "fields=summary,status,assignee,issuetype,updated" |
    jq -r '.issues[] | [.key, (.fields.status.name // "-"), (.fields.assignee.displayName // "unassigned"), (.fields.summary // "-")] | @tsv'
}

cmd_issue() {
  local key="${1:?usage: issue <KEY>}"
  api GET "${API}/issue/${key}" -G \
    --data-urlencode "fields=summary,status,assignee,reporter,issuetype,priority,updated,description,components,versions,fixVersions" |
    jq -r "${JQ_SHOW}"'
        "Key:        \(.key)",
        "Type:       \(.fields.issuetype.name // "-")",
        "Status:     \(.fields.status.name // "-")",
        "Priority:   \(.fields.priority.name // "-")",
        "Assignee:   \(.fields.assignee.displayName // "unassigned")",
        "Reporter:   \(.fields.reporter.displayName // "-")",
        "Updated:    \(.fields.updated // "-")",
        "Components: \(.fields.components | show)",
        "Affects:    \(.fields.versions | show)",
        "Fix:        \(.fields.fixVersions | show)",
        "Summary:    \(.fields.summary // "-")",
        "",
        (.fields.description // "(no description)")'
}

cmd_comments() {
  local key="${1:?usage: comments <KEY>}"
  api GET "${API}/issue/${key}/comment" |
    jq -r '.comments[] | "-- \(.author.displayName) @ \(.created)\n\(.body)\n"'
}

cmd_get() {
  local path="${1:?usage: get <api-path>   e.g. project/ABC}"
  api GET "${API}/${path}" | jq .
}

cmd_comment() {
  local key="${1:?usage: comment <KEY> <text>}"
  shift
  local text="${*:?usage: comment <KEY> <text>}"
  require_yes "comment ${key} ${text}"
  local body
  body="$(tmp_body)"
  jq -n --arg b "${text}" '{body: $b}' >"${body}"
  api POST "${API}/issue/${key}/comment" -H 'Content-Type: application/json' --data "@${body}" |
    jq -r '"commented on '"${key}"' (comment \(.id))"'
}

cmd_create() {
  local proj="${1:?usage: create <PROJECT> <TYPE> <SUMMARY> [DESCRIPTION]}"
  local type="${2:?usage: create <PROJECT> <TYPE> <SUMMARY> [DESCRIPTION]}"
  local summary="${3:?usage: create <PROJECT> <TYPE> <SUMMARY> [DESCRIPTION]}"
  local desc="${4:-}"
  if [[ "${proj}" == "IFS" ]]; then
    [[ -n "${JIRA_COMPONENTS:-}" ]] || die "creating IFS tickets requires JIRA_COMPONENTS"
    [[ -n "${JIRA_FIX_VERSIONS:-}" ]] || die "creating IFS tickets requires JIRA_FIX_VERSIONS"
    [[ -n "${JIRA_IFS_PARTS_AFFECTED:-}" ]] || die "creating IFS tickets requires JIRA_IFS_PARTS_AFFECTED"
  fi
  require_yes "create ${type} in ${proj}: ${summary}"
  local body out key
  body="$(tmp_body)"
  jq -n --arg p "${proj}" --arg t "${type}" --arg s "${summary}" --arg d "${desc}" \
    --arg comps "${JIRA_COMPONENTS:-}" --arg vers "${JIRA_FIX_VERSIONS:-}" \
    --arg parts "${JIRA_IFS_PARTS_AFFECTED:-}" '
    def csv2objs($s): ($s | split(",") | map(gsub("^ +| +$";"")) | map(select(length>0) | {name: .}));
    def csv2values($s): ($s | split(",") | map(gsub("^ +| +$";"")) | map(select(length>0) | {value: .}));
    {fields: ({project: {key: $p}, issuetype: {name: $t}, summary: $s}
      + (if $d == "" then {} else {description: $d} end)
      + (if $comps == "" then {} else {components: csv2objs($comps)} end)
      + (if $vers == "" then {} else {fixVersions: csv2objs($vers)} end)
      + (if $parts == "" then {} else {customfield_12111: csv2values($parts)} end))}' >"${body}"
  out="$(api POST "${API}/issue" -H 'Content-Type: application/json' --data "@${body}")"
  key="$(printf '%s' "${out}" | jq -r '.key')"
  printf 'created %s: %s/browse/%s\n' "${key}" "${BASE_URL}" "${key}"
}

cmd_set_description() {
  local key="${1:?usage: set-description <KEY> <text|->}"
  local text="${2:?usage: set-description <KEY> <text|->}"
  if [[ "${text}" == "-" ]]; then
    text="$(cat)"
  fi
  [[ -n "${text}" ]] || die "refusing to set an empty description on ${key}"
  require_yes "set-description ${key} <text>"
  local body
  body="$(tmp_body)"
  jq -n --arg d "${text}" '{fields: {description: $d}}' >"${body}"
  api PUT "${API}/issue/${key}" -H 'Content-Type: application/json' --data "@${body}" >/dev/null
  printf 'updated description of %s\n' "${key}"
}

# Map friendly names to Jira field IDs. Anything else is passed through and
# matched against the issue's editable field IDs and display names.
field_alias() {
  local f
  f="$(printf '%s' "${1}" | tr '[:upper:]' '[:lower:]')"
  case "${f}" in
    fix | fix-version | fix-versions | fixversion | fixversions) printf 'fixVersions' ;;
    affects | affects-version | affects-versions | version | versions) printf 'versions' ;;
    component | components) printf 'components' ;;
    label | labels) printf 'labels' ;;
    parts | parts-affected | ifs-parts-affected) printf 'customfield_12111' ;;
    *) printf '%s' "${1}" ;;
  esac
}

# resolve_field <editmeta-json> <field> -> field ID, or nothing if not editable
resolve_field() {
  local id
  id="$(field_alias "${2}")"
  printf '%s' "${1}" | jq -r --arg f "${id}" '
    [.fields | to_entries[]
      | select(.key == $f or ((.value.name // "") | ascii_downcase) == ($f | ascii_downcase))
      | .key] | first // empty'
}

cmd_fields() {
  local key="${1:?usage: fields <KEY> [FIELD]}" field="${2:-}"
  local meta fid
  meta="$(api GET "${API}/issue/${key}/editmeta")"
  if [[ -z "${field}" ]]; then
    printf '%s' "${meta}" | jq -r '
      .fields | to_entries[]
      | [.key, (.value.name // "-"),
         (.value.schema | if .type == "array" then "array<\(.items)>" else .type end),
         (.value.operations | join(","))] | @tsv'
    return
  fi
  fid="$(resolve_field "${meta}" "${field}")"
  [[ -n "${fid}" ]] || die "field '${field}' is not editable on ${key} (list editable fields with: ${PROG} fields ${key})"
  printf '%s' "${meta}" | jq -r --arg f "${fid}" '
    .fields[$f]
    | "\($f) (\(.name)); operations: \(.operations | join(","))",
      if .allowedValues == null then "(no fixed list of allowed values)"
      else .allowedValues[]
        | "  \(.name // .value)\(if .archived then " [archived]" elif .released then " [released]" else "" end)"
      end'
}

cmd_edit() {
  local usage="usage: edit <KEY> <FIELD> <set|add|remove|clear> [VALUE[,VALUE...]]"
  local key="${1:?${usage}}" field="${2:?${usage}}" op="${3:?${usage}}" values="${4:-}"
  case "${op}" in
    set | add | remove) [[ -n "${values}" ]] || die "'${op}' needs a value; use 'clear' to empty a field" ;;
    clear) [[ -z "${values}" ]] || die "'clear' takes no value" ;;
    *) die "unknown operation '${op}' (expected set, add, remove, or clear)" ;;
  esac

  local meta fid kind jop
  meta="$(api GET "${API}/issue/${key}/editmeta")"
  fid="$(resolve_field "${meta}" "${field}")"
  [[ -n "${fid}" ]] || die "field '${field}' is not editable on ${key} (list editable fields with: ${PROG} fields ${key})"
  kind="$(printf '%s' "${meta}" | jq -r --arg f "${fid}" \
    '.fields[$f].schema | if .type == "array" then "array:\(.items)" else .type end')"
  case "${kind#array:}" in
    version | component | option | string | user | group | priority | number | date | datetime) ;;
    *) die "field ${fid} has unsupported type '${kind}'" ;;
  esac
  if [[ "${kind}" != array:* && ("${op}" == "add" || "${op}" == "remove") ]]; then
    die "${fid} holds a single value; use 'set' or 'clear'"
  fi
  jop="${op}"
  if [[ "${op}" == "clear" ]]; then
    jop="set"
  fi
  printf '%s' "${meta}" | jq -e --arg f "${fid}" --arg o "${jop}" \
    '.fields[$f].operations | index($o)' >/dev/null ||
    die "Jira does not allow '${jop}' on ${fid} for ${key}"

  # Check new values against the allowed list (if Jira gives one). Removals are
  # not checked, so archived values can still be removed.
  if [[ "${op}" == "set" || "${op}" == "add" ]]; then
    local unknown
    unknown="$(printf '%s' "${meta}" | jq -r --arg f "${fid}" --arg v "${values}" "${JQ_CSV}"'
      .fields[$f] as $m
      | if $m.allowedValues == null then empty else
          ($m.allowedValues | map(.name // .value)) as $ok
          | (if $m.schema.type == "array" then ($v | csv) else [$v] end)
          | map(select(. as $x | $ok | any(. == $x) | not)) | join(", ")
        end')"
    [[ -z "${unknown}" ]] ||
      die "not allowed for ${fid} on ${key}: ${unknown} (list allowed values with: ${PROG} fields ${key} ${field})"
  fi

  local shown
  shown="${key} $(shell_quote "${field}") ${op}"
  if [[ -n "${values}" ]]; then
    shown+=" $(shell_quote "${values}")"
  fi
  require_yes "edit ${shown}"
  local body
  body="$(tmp_body)"
  printf '%s' "${meta}" | jq --arg f "${fid}" --arg o "${op}" --arg v "${values}" "${JQ_CSV}"'
    .fields[$f].schema as $s
    | ($s.type == "array") as $arr
    | (if $arr then $s.items else $s.type end) as $k
    | def wrap:
        if (["version", "component", "user", "group", "priority"] | any(. == $k)) then {name: .}
        elif $k == "option" then {value: .}
        elif $k == "number" then tonumber
        else . end;
    (if $o == "clear" then [] elif $arr then ($v | csv | map(wrap)) else [$v | wrap] end) as $vals
    | {update: {($f): (
        if $o == "clear" then [{set: (if $arr then [] else null end)}]
        elif $o == "set" then [{set: (if $arr then $vals else $vals[0] end)}]
        else [$vals[] | {($o): .}] end)}}' >"${body}"
  api PUT "${API}/issue/${key}" -H 'Content-Type: application/json' --data "@${body}" >/dev/null
  api GET "${API}/issue/${key}" -G --data-urlencode "fields=${fid}" |
    jq -r --arg f "${fid}" --arg k "${key}" "${JQ_SHOW}"'"updated \($f) on \($k): \(.fields[$f] | show)"'
}

cmd_transition() {
  local key="${1:?usage: transition <KEY> <TRANSITION-NAME>}"
  local name="${2:?usage: transition <KEY> <TRANSITION-NAME>}"
  require_yes "transition ${key} -> ${name}"
  local tid body
  tid="$(api GET "${API}/issue/${key}/transitions" |
    jq -r --arg n "${name}" '.transitions[] | select(.name | ascii_downcase == ($n | ascii_downcase)) | .id' | head -n1)"
  [[ -n "${tid}" ]] || die "no transition named '${name}' available for ${key}"
  body="$(tmp_body)"
  jq -n --arg id "${tid}" '{transition: {id: $id}}' >"${body}"
  api POST "${API}/issue/${key}/transitions" -H 'Content-Type: application/json' --data "@${body}" >/dev/null
  printf 'transitioned %s -> %s\n' "${key}" "${name}"
}

cmd_assign() {
  local key="${1:?usage: assign <KEY> <USERNAME>}"
  local user="${2:?usage: assign <KEY> <USERNAME>}"
  require_yes "assign ${key} to ${user}"
  local body
  body="$(tmp_body)"
  jq -n --arg u "${user}" '{name: $u}' >"${body}"
  api PUT "${API}/issue/${key}/assignee" -H 'Content-Type: application/json' --data "@${body}" >/dev/null
  printf 'assigned %s to %s\n' "${key}" "${user}"
}

usage() {
  cat <<EOF
${PROG} — ECMWF Jira (Data Center) broker. Token stays local; never sent to the LLM.

Read:
  ${PROG} whoami                         test auth; show current user
  ${PROG} search "<JQL>" [max]           search issues (TSV: key status assignee summary)
  ${PROG} issue <KEY>                     show one issue with description
  ${PROG} comments <KEY>                  list comments on an issue
  ${PROG} fields <KEY> [FIELD]            list editable fields, or one field's allowed values
  ${PROG} get <api-path>                  raw GET under ${API}/ (e.g. get project/ABC)

Write (require --yes after user confirmation):
  ${PROG} --yes comment <KEY> <text>
  ${PROG} --yes create <PROJECT> <TYPE> <SUMMARY> [DESCRIPTION]
  ${PROG} --yes set-description <KEY> <text|->   replace description ('-' reads stdin)
  ${PROG} --yes edit <KEY> <FIELD> <set|add|remove|clear> [VALUE[,VALUE...]]
  ${PROG} --yes transition <KEY> <TRANSITION-NAME>
  ${PROG} --yes assign <KEY> <USERNAME>

Config: PAT in ${CONFIG_DIR}/pat[_*] (chmod 600); optional base_url in ${CONFIG_DIR}/config
        (default ${DEFAULT_BASE_URL}).
Create fields: JIRA_COMPONENTS, JIRA_FIX_VERSIONS, JIRA_IFS_PARTS_AFFECTED (comma-separated).
Edit FIELD: a field ID, a display name, or an alias: fix, affects, components, labels, parts.
EOF
}

main() {
  need curl
  need jq
  trap cleanup EXIT

  local -a rest=()
  local a
  for a in "${@}"; do
    case "${a}" in
      -y | --yes) ASSUME_YES=1 ;;
      *) rest+=("${a}") ;;
    esac
  done
  if [[ "${#rest[@]}" -gt 0 ]]; then
    set -- "${rest[@]}"
  else
    set --
  fi

  local cmd="${1:-help}"
  [[ "${#}" -gt 0 ]] && shift

  case "${cmd}" in
    help | -h | --help)
      usage
      return 0
      ;;
  esac

  preflight
  case "${cmd}" in
    whoami | myself) cmd_whoami ;;
    search) cmd_search "${@}" ;;
    issue) cmd_issue "${@}" ;;
    comments) cmd_comments "${@}" ;;
    fields) cmd_fields "${@}" ;;
    get) cmd_get "${@}" ;;
    comment) cmd_comment "${@}" ;;
    create) cmd_create "${@}" ;;
    set-description) cmd_set_description "${@}" ;;
    edit) cmd_edit "${@}" ;;
    transition) cmd_transition "${@}" ;;
    assign) cmd_assign "${@}" ;;
    *) die "unknown command: ${cmd} (try: ${PROG} help)" ;;
  esac
}

main "${@}"
